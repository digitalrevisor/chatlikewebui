{
  "name": "chatlikewebui",
  "version": "0.1.0",
  "private": true,
  "description": "A ChatGPT-like chat on Digital Revisor's OpenWebUI: conversations, streaming, agents, files, knowledge and tools",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p server/tsconfig.json && vite build web",
    "start": "node server/dist/src/main.js",
    "dev": "vite web",
    "dev:server": "tsc -p server/tsconfig.json && node server/dist/src/main.js",
    "test": "tsc -p server/tsconfig.json && node --test --test-concurrency=1 server/dist/test/*.test.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bootstrap": "^5.3.8",
    "lucide-react": "^1.67.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
