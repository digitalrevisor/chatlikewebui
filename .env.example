# The OpenWebUI instance the chat uses
OPENWEBUI_URL=http://217.149.113.34:3000
# Encrypts the sign-in cookie (the person's OpenWebUI token is inside it). Make one with: openssl rand -hex 32
SESSION_SECRET=
# How long a sign-in lasts, in hours
SESSION_HOURS=12
# The address people open; https:// makes the cookie Secure
APP_URL=https://chat.digitalrevisor.no
PORT=3800
# Where conversations are kept (one folder per person)
DATA_DIR=/var/lib/chatlikewebui
